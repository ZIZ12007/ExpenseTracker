# Copy to backend/.env and fill in the values. Never commit the real file.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/expensetracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expensetracker?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/expensetracker

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on. Render/Railway inject PORT automatically.
PORT=8000

# Only needed when the frontend is hosted on a different origin than the API
# (e.g. Netlify/Vercel + Render). Leave unset for a single-service deploy.
# CLIENT_URL=https://your-app.netlify.app

# Where the app lives, used for the links in the verification and password
# reset emails. On a single-service deploy this is the same URL as the API.
# FRONTEND_URL=https://your-app.vercel.app

# Google sign in. Create an OAuth 2.0 Web client in the Google Cloud Console
# and add this redirect URI:
#   https://your-app.vercel.app/api/v1/auth/google/callback
# When these are missing the "Continue with Google" button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email for verification and password recovery, through Resend (3,000 a month
# free). Without a key the emails are written to the server log instead.
# MAIL_FROM=Expense Tracker <noreply@your-domain.com>
# RESEND_API_KEY=

# Google Gemini, for the food recommendations and reading the school
# timetable (about 1,500 requests a day free, no credit card). Without a key
# the app uses its own rule based planner.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: store uploaded images in Cloudinary instead of on the local disk.
# Local disk is wiped on every redeploy on most hosts, so this is what makes
# profile photos survive. Get the values from
# https://console.cloudinary.com/settings/api-keys (the "demo" cloud name in
# the docs works for testing). Leave unset to keep using local disk.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=expensetracker/avatars
