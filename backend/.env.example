# Copy to backend/.env and fill in the values. Never commit the real file.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/expensetracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expensetracker?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/expensetracker

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on. Render/Railway inject PORT automatically.
PORT=8000

# Only needed when the frontend is hosted on a different origin than the API
# (e.g. Netlify/Vercel + Render). Leave unset for a single-service deploy.
# CLIENT_URL=https://your-app.netlify.app

# Optional: store uploaded images in Cloudinary instead of on the local disk.
# Local disk is wiped on every redeploy on most hosts, so this is what makes
# profile photos survive. Get the values from
# https://console.cloudinary.com/settings/api-keys (the "demo" cloud name in
# the docs works for testing). Leave unset to keep using local disk.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=expensetracker/avatars
