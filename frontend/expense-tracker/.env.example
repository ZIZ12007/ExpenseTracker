# Copy to frontend/expense-tracker/.env and fill in the values.

# Base URL of the backend API.
# Local development: the Vite dev server runs on 5173 and there is no proxy,
# so the API URL must be set explicitly.
# Production (single service): leave empty so the app calls the API on its own
# origin, which is what the backend serves.
VITE_API_URL=http://localhost:8000
